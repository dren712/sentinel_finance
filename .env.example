# ============================================================================
# SENTINEL FINANCE — CANONICAL DOCKER DEPLOYMENT ENVIRONMENT
# Architecture: 1 Next.js Docker Container (Railway / Render / Fly) + 1 Managed Postgres
# ============================================================================

# 1. Solana Cluster (LOCAL | DEVNET | MAINNET)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# 2. Browser RPC (NEXT_PUBLIC_SOLANA_RPC)
# Used by browser wallet adapter for balances, account reads, tx status, and Explorer links.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# 3. Server RPC (SOLANA_RPC_URL)
# Used strictly server-side for agent execution, Pyth update workflows,
# server-side verification, and indexing/reconciliation (never exposed to browser).
SOLANA_RPC_URL=https://api.devnet.solana.com

# 4. Deployed Solana Anchor Program ID & Default Owner Authority
SENTINEL_PROGRAM_ID=3gh1Cc2Qc65hJhxZKneXphWJa27z5adyFayc9kWEvAJK
NEXT_PUBLIC_SENTINEL_PROGRAM_ID=3gh1Cc2Qc65hJhxZKneXphWJa27z5adyFayc9kWEvAJK
NEXT_PUBLIC_DEFAULT_OWNER_WALLET=GR9CtiUswZtay68U2fGqcDeB1dg8sHtpVi9kk2nCEwzw

# 5. Managed Postgres Read History Store (Server-Only)
# Tables: agent_runs, decisions, executions, portfolio_snapshots, evidence_index
DATABASE_URL=

# 6. Autonomous Agent LLM Connector (Server-Only)
OPENAI_API_KEY=
