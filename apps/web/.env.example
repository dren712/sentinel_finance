# Solana Cluster Configuration
# Options: localnet | devnet | mainnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Solana RPC URL (defaults derived from cluster)
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Sentinel Anchor Program ID (deployed on-chain)
SENTINEL_PROGRAM_ID=3gh1Cc2Qc65hJhxZKneXphWJa27z5adyFayc9kWEvAJK

# PDA Overrides (derived from program ID if not set)
# SENTINEL_POLICY_PDA=
# SENTINEL_AGENT_PDA=
# SENTINEL_VAULT_PDA=

# Feature Flags
# NEXT_PUBLIC_LIVE_PRICES=false
# NEXT_PUBLIC_DEMO_MODE=true

# OpenAI (optional — for LLM-driven agent proposals)
# OPENAI_API_KEY=

# Postgres (optional — defaults to in-memory)
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
